<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: stessa regola per backup su cloud e trasferimento da device a device. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
